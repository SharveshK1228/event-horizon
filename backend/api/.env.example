EH_SCENARIO=tracking

# Optional assistant backend. Without any key the assistant serves its
# deterministic scripted answer, which is always grounded in the incident and
# the selected SOP. Keep real keys in .env only; never commit them.
#
# Keys are read from the repository-root .env first, then from this folder's
# .env, which wins where both set the same name.
#
# LLM_PROVIDER picks between the keys you have set. Omit it and the first
# provider with a key is used.
# LLM_PROVIDER=groq          # groq | gemini | openai
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
#
# Model overrides, one per provider. Defaults:
#   groq   -> openai/gpt-oss-120b
#   gemini -> gemini-flash-latest
#   openai -> gpt-5-mini
# GROQ_MODEL=
# GEMINI_MODEL=
# OPENAI_MODEL=

# Demo video library. Defaults to `<repo>/sample crowd videos` and
# `backend/api/uploads`; both are playback only, and neither is analysed.
# EH_SAMPLE_VIDEOS=
# EH_UPLOAD_DIR=
